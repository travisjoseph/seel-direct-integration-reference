  "contract_cases": [
    {
      "name": "attach minted",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "contract_id": "ct_1"
          }
        ]
      },
      "response_json": "{\"seel_services\": [{\"type\": \"acme-wfp\", \"contract_id\": \"ct_1\"}]}",
      "expect_minted": true
    },
    {
      "name": "contract_id null",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "contract_id": null
          }
        ]
      },
      "response_json": "{\"seel_services\": [{\"type\": \"acme-wfp\", \"contract_id\": null}]}",
      "expect_minted": false,
      "note": "the common silent failure: HTTP 200 with no coverage"
    },
    {
      "name": "contract_id empty string",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "contract_id": ""
          }
        ]
      },
      "response_json": "{\"seel_services\": [{\"type\": \"acme-wfp\", \"contract_id\": \"\"}]}",
      "expect_minted": false
    },
