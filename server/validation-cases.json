          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": null
      },
      "response_json": "{\"seel_services\": null}",
      "expect_minted": false,
      "note": "what a top-level quote_id produces"
    },
    {
      "name": "seel_services absent",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "order_id": "o-1"
      },
      "response_json": "{\"order_id\": \"o-1\"}",
      "expect_minted": false
    },
    {
      "name": "seel_services empty array",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": []
      },
      "response_json": "{\"seel_services\": []}",
      "expect_minted": false
    },
    {
      "name": "contract_id is a string starting with zero",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "response": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "contract_id": "012"
          }
        ]
      },
      "response_json": "{\"seel_services\": [{\"type\": \"acme-wfp\", \"contract_id\": \"012\"}]}",
      "expect_minted": true,
      "note": "a real id, not a falsy zero"
    }
  ],
  "uncovered_requests": [
    {
      "name": "no seel_services is a normal sync",
      "request": {
        "order_id": "o-1"
      },
      "request_json": "{\"order_id\": \"o-1\"}",
      "expect_checked": false
    },
    {
      "name": "empty seel_services is a normal sync",
      "request": {
        "order_id": "o-1",
        "seel_services": []
      },
      "request_json": "{\"order_id\": \"o-1\", \"seel_services\": []}",
      "expect_checked": false
    },
    {
      "name": "a populated seel_services array is checked",
      "request": {
        "seel_services": [
          {
            "type": "acme-wfp",
            "quote_id": "q-1",
            "price": 0.98
          }
        ]
      },
      "request_json": "{\"seel_services\": [{\"type\": \"acme-wfp\", \"quote_id\": \"q-1\", \"price\": 0.98}]}",
      "expect_checked": true
    }
  ]
