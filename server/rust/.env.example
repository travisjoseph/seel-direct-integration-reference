# Copy to .env and fill in with the values Seel provides during onboarding (never commit .env)
SEEL_API_KEY=
SEEL_WEBHOOK_SECRET=
# Program-specific values. When set, the quote proxy injects them into every
# quote request so storefront code needs no program-specific values at all.
SEEL_MERCHANT_ID=
# Platform proxy instead: a JSON object of storefront origin to merchant_id,
# e.g. {"https://shop-a.example":"merchant-id-a"}. The proxy stamps the
# merchant for the request's Origin. Mutually exclusive with SEEL_MERCHANT_ID.
SEEL_RETAILER_MERCHANTS=
SEEL_QUOTE_TYPE=
# sandbox default; switch to https://api.seel.com for production
SEEL_BASE_URL=https://api-test.seel.com
PORT=8787
