# Export these into the process environment before running (the server reads
# them with Environment.GetEnvironmentVariable; there is no .env loader).
# Never commit real values.
SEEL_API_KEY=
SEEL_WEBHOOK_SECRET=
# Program-specific values. When set, the quote proxy injects them into every
# quote request so storefront code needs no program-specific values at all.
SEEL_MERCHANT_ID=
SEEL_QUOTE_TYPE=
# Platform proxy only, instead of SEEL_MERCHANT_ID (setting both refuses to
# start): JSON object mapping each retailer storefront origin to its merchant.
# Quotes are bound to the merchant for the request's Origin header.
# SEEL_RETAILER_MERCHANTS={"https://shop-a.example":"merchant-id-a","https://shop-b.example":"merchant-id-b"}
SEEL_RETAILER_MERCHANTS=
# sandbox default; switch to https://api.seel.com for production
SEEL_BASE_URL=https://api-test.seel.com
PORT=8787
