# Copy to .env and fill in with the values Seel provides during onboarding (never commit .env)
SEEL_API_KEY=
SEEL_WEBHOOK_SECRET=
# Program-specific values. When set, the quote proxy injects them into every
# quote request so storefront code needs no program-specific values at all.
SEEL_MERCHANT_ID=
SEEL_QUOTE_TYPE=
# Platform proxy only: JSON object of retailer storefront origin to merchant_id.
# Each request is stamped with the merchant for its Origin. Set this or
# SEEL_MERCHANT_ID, never both; the server refuses to start with both.
# SEEL_RETAILER_MERCHANTS={"https://shop-a.example":"merchant-id-a"}
# sandbox default; switch to https://api.seel.com for production
SEEL_BASE_URL=https://api-test.seel.com
PORT=8787
