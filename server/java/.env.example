# Export these into the process environment before running (the server reads
# them via System.getenv; there is no .env loader). Never commit real values.
SEEL_API_KEY=
SEEL_WEBHOOK_SECRET=
# Program-specific values. When set, the quote proxy injects them into every
# quote request so storefront code needs no program-specific values at all.
SEEL_MERCHANT_ID=
SEEL_QUOTE_TYPE=
# sandbox default; switch to https://api.seel.com for production
SEEL_BASE_URL=https://api-test.seel.com
PORT=8787
